# Development only. Do not reuse these values in production.
POSTGRES_DB=petfood
POSTGRES_USER=petfood
POSTGRES_PASSWORD=petfood_local_only
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8080
FRONTEND_PORT=5173
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# Compose defaults to Mailpit. For real SMTP set host, port and credentials.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=noreply@petfood.local
# First ADMIN account, created once at startup when the email is set.
# Choose your own password (8-64 chars) in .env; restarting never resets it.
PETFOOD_ADMIN_EMAIL=
PETFOOD_ADMIN_PASSWORD=
# Gemini API for semantic search and the assistant. Leave AI_ENABLED=false to use keyword fallback only.
# Put your own key in .env (never commit it). Calls may be billed by Google beyond the free tier.
AI_ENABLED=false
AI_API_KEY=
AI_CHAT_MODEL=gemini-3.8-flash
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_QUOTA_PER_MINUTE=10

