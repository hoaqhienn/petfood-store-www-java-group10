# Development only. Do not reuse these values in production.
POSTGRES_DB=petfood
POSTGRES_USER=petfood
POSTGRES_PASSWORD=petfood_local_only
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8080
FRONTEND_PORT=5173
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# Compose defaults to Mailpit. For real SMTP set host, port and credentials.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=noreply@petfood.local
# Reserved for future AI implementation; no paid API calls in this scaffold.
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=

